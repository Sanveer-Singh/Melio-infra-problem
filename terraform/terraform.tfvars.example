# Melio DevOps Assessment -- Terraform Variables
# Copy this file to terraform.tfvars and adjust values as needed.
# terraform.tfvars is gitignored to prevent committing sensitive values.

region       = "af-south-1"
project_name = "melio-devops"
environment  = "dev"
instance_type = "t3.small"
aws_profile  = "charteracademy"

# Uncomment and set to YOUR_IP/32 for SSH access (debug only)
# ssh_cidr = "203.0.113.0/32"

# S3 artifact bucket ARN (from bootstrap output)
artifact_bucket_arn = "arn:aws:s3:::melio-devops-dev-artifacts"

# Newsfeed service token -- pass via CLI, never commit the actual value:
#   terraform apply -var="newsfeed_service_token=YOUR_TOKEN"
